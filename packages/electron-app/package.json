{
  "name": "@gh-dashboard/electron-app",
  "productName": "TINT Viewer",
  "version": "0.0.2",
  "description": "View your open pull requests across all repositories",
  "author": "TINT Viewer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && node scripts/patch-electron-name.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "echo 'No tests configured'",
    "lint": "echo 'No linter configured'",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "clean": "rm -rf dist dist-electron release",
    "deploy": "echo 'No deploy configured'",
    "package": "vite build && tsc -p tsconfig.electron.json && electron-builder"
  },
  "dependencies": {
    "@gh-dashboard/github-gh-cli": "workspace:*",
    "@gh-dashboard/github-types": "workspace:*",
    "@gh-dashboard/github-ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.tint-viewer",
    "productName": "TINT Viewer",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": "dmg"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "release"
    }
  }
}
